{
  "name": "@pfsa/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@pfsa/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.15",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
